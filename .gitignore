# Java and Maven build output
target/
build/
out/
*.class
*.jar
*.war
*.nar
*.ear
*.ctxt

# Logs and JVM crash reports
*.log
hs_err_pid*
replay_pid*

# IDE files (keep shared project settings; ignore local/generated state)
.idea/workspace.xml
.idea/tasks.xml
.idea/usage.statistics.xml
.idea/shelf/
.idea/httpRequests/
.idea/dataSources/
.idea/compiler.xml
.idea/encodings.xml
.idea/jarRepositories.xml
.idea/modules.xml
*.iml
.mtj.tmp/

# Local servers and generated runtime files
.local-apache/
wildfly/
wildfly-*/

# Local environment and secrets
.env
.env.*
!.env.example

# macOS metadata
.DS_Store
.AppleDouble
.LSOverride
._*
.Spotlight-V100/
.Trashes/

# Postman local workspace metadata
.postman/
postman/**/.resources/
postman/globals/workspace.globals.yaml
